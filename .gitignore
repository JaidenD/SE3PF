# Build directories (build/, build-rel/, build-dbg/, build-ci-debug/, ...) and the logs of tools/ci.sh, at the root
/build*/
/build-ci-*.log

# Generated by the apps and the plot scripts; regenerate them instead of committing them.
# To track a figure anyway: git add -f out/rigid_body.png
/out/

# Robot logs (docs/HARDWARE.md): keep them, but outside git (they are tens of MB); git add -f to track one anyway
/logs/
robot_*.csv
robot_*.csv.*

# Downloaded by tools/fetch_mujoco.sh (MuJoCo and the Menagerie Panda) and the Python venv; only the README is ours.
# No trailing slash on .venv, so that it also matches a symbolic link. (If third_party itself is a symbolic link,
# as in a scratch workspace, add /third_party to .git/info/exclude.)
/third_party/*
!/third_party/README.md
.venv

# Python bytecode caches of the tools/ scripts
__pycache__/

# Editors and language servers
compile_commands.json
.cache/
.vscode/
.idea/

# Logs of scratch runs (e.g. docs/closed_lifts/work/*.log) and the lab session's terminal record (docs/HARDWARE.md)
*.log
session.txt

# Compiler and debugger leftovers outside the build directories
*.o
*.a
*.so
a.out
core
core.*

# Editor and OS clutter
*~
*.swp
.DS_Store
